  m_text: "\u0423 \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0430 \u0442\u044B \u043C\u043E\u0436\u0435\u0448\u044C
    \u043F\u043E\u043A\u0443\u043F\u0430\u0442\u044C \u0443\u043D\u0438\u043A\u0430\u043B\u044C\u043D\u044B\u0435
    \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B \u0438 \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u044F
    \u0437\u0430 \u0437\u043E\u043B\u043E\u0442\u043E.\n\n\u041F\u0440\u043E\u0434\u0430\u0432\u0430\u0439
    \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u043D\u044B\u0435
    \u0442\u043E\u0431\u043E\u0439 \u0437\u0435\u043B\u044C\u044F, \u0447\u0442\u043E-\u0431\u044B
    \u0437\u0430\u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C \u043D\u0430 \u0441\u0432\u043E\u0438
    \u043D\u0443\u0436\u0434\u044B."
