    \u0440\u043E\u0434\u043D\u043E\u0439, \u0434\u0430\u0436\u0435 \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u0438\u043D\u0433\u0440\u0435\u0434\u0438\u0435\u043D\u0442\u044B \u043E\u0431\u043B\u0430\u0434\u0430\u044E\u0442
    \u0442\u0435\u043C\u0438 \u0436\u0435 \u0441\u0432\u043E\u0439\u0441\u0442\u0432\u0430\u043C\u0438.
    \u0421\u043E\u0431\u0435\u0440\u0438 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u044B\u0435
    \u0442\u0435\u0431\u0435 \u0438 \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0439
    \u0441\u043E\u0437\u0434\u0430\u0442\u044C \u0438\u0437 \u043D\u0438\u0445 \u0437\u0435\u043B\u044C\u0435."
