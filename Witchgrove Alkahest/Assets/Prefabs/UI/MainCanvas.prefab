      m_Calls: []
  m_text: "\u0422\u044B - \u0432\u0435\u0434\u044C\u043C\u0430, \u043A\u043E\u0442\u043E\u0440\u0430\u044F
    \u043F\u043E\u043F\u0430\u043B\u0430 \u0432 \u044D\u0442\u043E\u0442 \u043C\u0438\u0440
    \u0432\u043E \u0432\u0440\u0435\u043C\u044F \u044D\u043A\u0441\u043F\u0435\u0440\u0438\u043C\u0435\u043D\u0442\u043E\u0432
    \u0441 \u043A\u043E\u043B\u0434\u043E\u0432\u0441\u0442\u0432\u043E\u043C. \u041A\u0430\u043A
    \u0443\u0434\u0430\u0447\u043D\u043E \u0447\u0442\u043E \u043C\u0435\u0441\u0442\u043E
    \u043A\u0443\u0434\u0430 \u0442\u0435\u0431\u044F \u043F\u0435\u0440\u0435\u043D\u0435\u0441\u043B\u043E, 
    \u043F\u0440\u043E\u043F\u0438\u0442\u0430\u043D\u043E \u043C\u0430\u0433\u0438\u0435\u0439,
    \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E \u0440\u0430\u043D\u044C\u0448\u0435
    \u0442\u0443\u0442 \u0436\u0438\u043B\u0438 \u043B\u044E\u0434\u0438 \u0437\u043D\u0430\u043A\u043E\u043C\u044B\u0435
    \u0441 \u043A\u043E\u043B\u0434\u043E\u0432\u0441\u0442\u0432\u043E\u043C.\r\n\r\n\u041D\u0430\u0439\u0434\u0438
    \u0441\u043F\u043E\u0441\u043E\u0431 \u043A\u0430\u043A \u043C\u043E\u0436\u043D\u043E
    \u0441\u043A\u043E\u0440\u0435\u0435 \u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F
    \u0432 \u0440\u043E\u0434\u043D\u043E\u0439 \u043C\u0438\u0440, \u0438\u043D\u0430\u0447\u0435
    \u043A\u0442\u043E \u0431\u0443\u0434\u0435\u0442 \u043A\u043E\u0440\u043C\u0438\u0442\u044C
    \u0442\u0432\u043E\u0435\u0433\u043E \u043F\u0438\u0442\u043E\u043C\u0446\u0430?!"
