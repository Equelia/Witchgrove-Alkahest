  - questId: "\u0412\u043E\u0437\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u0435
      \u0414\u043E\u043C\u043E\u0439"
    description: "\u041F\u043E\u0445\u043E\u0436\u0435 \u0432\u043E\u0437\u0432\u0440\u0430\u0448\u0435\u043D\u0438\u0435
      \u0434\u043E\u043C\u043E\u0439 \u0441\u043E\u0432\u0441\u0435\u043C \u0431\u043B\u0438\u0437\u043A\u043E.\n\u041F\u043E\u0431\u043B\u0438\u0437\u043E\u0441\u0442\u0438
      \u0432\u0438\u0434\u0435\u043B\u0438 \u0441\u0442\u0440\u0430\u043D\u043D\u044B\u0439
      \u0430\u043B\u0442\u0430\u0440\u044C \u0441\u0442\u043E\u044F\u0449\u0438\u0439
      \u043D\u0430 \u043F\u0430\u0440\u044F\u0449\u0438\u0445 \u043A\u0430\u043C\u043D\u044F\u0445,
      \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E \u0435\u0441\u043B\u0438 \u043F\u043E\u0434\u043E\u0431\u0440\u0430\u0442\u044C
      \u043D\u0443\u0436\u043D\u0443\u044E \u043A\u043E\u043C\u0431\u0438\u043D\u0430\u0446\u0438\u044E
      \u0440\u0435\u0430\u0433\u0435\u043D\u0442\u043E\u0432 \u0438 \u0432\u043E\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C\u0441\u044F
      \u0438\u043C, \u043C\u043E\u0436\u043D\u043E \u0431\u0443\u0434\u0435\u0442
      \u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F \u0432 \u0441\u0432\u043E\u0435
      \u043F\u0440\u0438\u0441\u0442\u0430\u043D\u0438\u0449\u0435.\n\n\n\u0418\u043D\u0433\u0440\u0438\u0434\u0438\u0435\u043D\u0442\u044B:\n1.
      \u0420\u043E\u0433 \u0415\u0434\u0438\u043D\u043E\u0440\u043E\u0433\u0430\n2.
      \u041F\u0435\u043F\u0435\u043B \u0424\u0435\u043D\u0438\u043A\u0441\u0430\n3.
      \u041F\u0435\u0440\u043E \u0416\u0430\u0440-\u041F\u0442\u0438\u0446\u044B"
